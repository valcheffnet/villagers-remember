{
	"schemaVersion": 1,
	"id": "villagersremember",
	"version": "${version}",
	"name": "Villagers Remember",
	"description": "Villagers ask you for help: craft, hunt, fish, explore. Earn their trust, better prices, a share of their work and the title of patron. Server-side, works with vanilla clients.",
	"authors": [
		"SasnycoN"
	],
	"contact": {
		"homepage": "https://github.com/valcheffnet/villagers-remember",
		"sources": "https://github.com/valcheffnet/villagers-remember",
		"issues": "https://github.com/valcheffnet/villagers-remember/issues"
	},
	"license": "LicenseRef-All-Rights-Reserved",
	"icon": "assets/villagersremember/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.valcheff.villagersremember.VillagersRemember"
		],
		"client": [
			"net.valcheff.villagersremember.client.VillagersRememberClient"
		],
		"modmenu": [
			"net.valcheff.villagersremember.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"villagersremember.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
